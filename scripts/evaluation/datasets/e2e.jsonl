# mock 字段用于注入故障（tool_error / llm_error），由脚本处理
{"id":"E01","category":"order","input":"帮我查询订单 ORD001 的信息","expected":{"intent":"order_query","tools":["get_order"],"key_params":{"order_id":"ORD001"},"must_have":[["ORD001"],["199.90","199.9"]],"tools_required":true},"note":"标准订单查询"}
