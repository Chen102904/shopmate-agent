{"id": "E03", "category": "order", "input": "ORD003 现在是什么状态", "expected": {"intent": "order_query", "tools": ["get_order"], "key_params": {"order_id": "ORD003"}, "must_have": [["已签收", "delivered", "已送达"]], "tools_required": true}, "note": "状态", "user_id": "USER002"}
{"id":"E04","category":"order","input":"我订单 ORD001 什么时候下的单","expected":{"intent":"order_query","tools":["get_order"],"key_params":{"order_id":"ORD001"},"must_have":[["ORD001"]],"tools_required":true},"note":"下单时间"}
{"id":"E05","category":"logistics","input":"帮我查询订单 ORD002 的物流信息","expected":{"intent":"logistics_query","tools":["get_logistics"],"key_params":{"order_id":"ORD002"},"must_have":[["ORD002"],["SF123456"]],"tools_required":true},"note":"标准物流查询"}
{"id":"E06","category":"logistics","input":"ORD002 的快递到哪了","expected":{"intent":"logistics_query","tools":["get_logistics"],"key_params":{"order_id":"ORD002"},"must_have":[["SF123456","顺丰"]],"tools_required":true},"note":"口语"}
{"id": "E07", "category": "logistics", "input": "ORD003 的物流签收了吗", "expected": {"intent": "logistics_query", "tools": ["get_logistics"], "key_params": {"order_id": "ORD003"}, "must_have": [["YT654321", "圆通", "已签收"]], "tools_required": true}, "note": "签收状态", "user_id": "USER002"}
{"id":"E08","category":"logistics","input":"我的包裹到哪了，单号 ORD002","expected":{"intent":"logistics_query","tools":["get_logistics"],"key_params":{"order_id":"ORD002"},"must_have":[["SF123456","顺丰"]],"tools_required":true},"note":"包裹=物流"}
