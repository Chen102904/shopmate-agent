{"id":"E10","category":"refund","input":"ORD002 能退钱吗","expected":{"intent":"refund_query","tools":["check_refund_eligibility"],"key_params":{"order_id":"ORD002"},"must_have":[["退款","退"]],"tools_required":true},"note":"口语"}
{"id": "E11", "category": "refund", "input": "帮我检查 ORD003 的退款资格", "expected": {"intent": "refund_query", "tools": ["check_refund_eligibility"], "key_params": {"order_id": "ORD003"}, "must_have": [["退款"]], "tools_required": true}, "note": "ORD003 已签收 10 天，应触发超期逻辑", "user_id": "USER002"}
